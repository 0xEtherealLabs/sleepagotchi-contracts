# Solana CLI keypair — a JSON array of the 64 secret key bytes. Signs every
# deploy and every admin instruction. Defaults to the CLI's own keypair.
SOLANA_DEPLOYER_KEYPAIR="~/.config/solana/id.json"

# Only `pnpm token:upload:<cluster>`, which pins the token image and metadata
# document to IPFS. Both are needed: the secret authorizes the upload, the
# client id keys the gateway subdomain. https://thirdweb.com/dashboard
NEXT_PUBLIC_THIRDWEB_CLIENT_ID=""
THIRDWEB_SECRET_KEY=""
